{
  "name": "tubetrend",
  "version": "1.0.0",
  "private": true,
  "description": "YouTube trend analysis tool - analyze video performance, track favorites, and discover trending content",
  "author": "fo0 (https://github.com/fo0)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fo0/tubetrend.git"
  },
  "bugs": {
    "url": "https://github.com/fo0/tubetrend/issues"
  },
  "homepage": "https://github.com/fo0/tubetrend#readme",
  "keywords": [
    "youtube",
    "trends",
    "analytics",
    "react",
    "vite",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync android && cd android && ./gradlew assembleRelease",
    "cap:build:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "build:extension": "vite build && node scripts/build-extension.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource/inter": "^5.2.8",
    "i18next": "^26.4.5",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.7",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16"
  },
  "overrides": {
    "brace-expansion@1": "^1.1.12",
    "brace-expansion@2": "^2.0.2",
    "brace-expansion@3": "^3.0.1",
    "brace-expansion@4": "^4.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4"
  }
}
